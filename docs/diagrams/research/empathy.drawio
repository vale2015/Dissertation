        <mxCell id="17" parent="38" vertex="1" value="Will the weekend be busier? Which days will be quiet? Can" style="text;html=0;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#425F62;fontStyle=0;spacing=0;">
