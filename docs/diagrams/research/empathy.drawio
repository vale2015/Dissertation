        </mxCell>
        <mxCell id="12" parent="37" vertex="1" value="information in one simple system. Has little time for" style="text;html=0;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#425F62;fontStyle=0;spacing=0;">
